# Shared configuration for every script in scripts/.
# Source it: source "$(dirname "${BASH_SOURCE[0]}")/config.env"
# Any value can be overridden from the environment before running a script.
# PROJECT_ID has no default on purpose: scripts must stop if it is unset.

export PROJECT_ID="${PROJECT_ID:-}"
export REGION="${REGION:-us-central1}"
export ZONE="${ZONE:-us-central1-a}"
export CLUSTER_NAME="${CLUSTER_NAME:-nim-demo}"

# GPU node pool: one NVIDIA L4 on the G2 series. L4 is not in NVIDIA's current
# NIM support matrix for this model; it is measured working (docs/runs/).
export GPU_TYPE="${GPU_TYPE:-nvidia-l4}"
export GPU_COUNT="${GPU_COUNT:-1}"
export NODE_POOL_MACHINE_TYPE="${NODE_POOL_MACHINE_TYPE:-g2-standard-4}"
export CLUSTER_MACHINE_TYPE="${CLUSTER_MACHINE_TYPE:-e2-standard-4}"

# NIM chart and image (pinned to the versions in the measured run).
export NIM_CHART_VERSION="${NIM_CHART_VERSION:-1.3.0}"
export NIM_IMAGE_REPO="${NIM_IMAGE_REPO:-nvcr.io/nim/meta/llama3-8b-instruct}"
export NIM_IMAGE_TAG="${NIM_IMAGE_TAG:-1.0.0}"
# Hourly cost estimates for monitor_deployment.sh, list prices from the
# measured runs (docs/runs/2026-09-27-measured-run.md): cluster fee + e2 node
# + boot disk, and the same plus one g2-standard-4 with an L4.
export COST_PER_HOUR_BASE="${COST_PER_HOUR_BASE:-0.25}"
export COST_PER_HOUR_GPU="${COST_PER_HOUR_GPU:-0.98}"
export NIM_RELEASE_NAME="${NIM_RELEASE_NAME:-my-nim}"
export NIM_NAMESPACE="${NIM_NAMESPACE:-nim}"

# NGC key: the nim-llm chart reads NGC_API_KEY. NGC_CLI_API_KEY is accepted as a fallback.
export NGC_API_KEY="${NGC_API_KEY:-${NGC_CLI_API_KEY:-}}"

# Autoscale test path (scripts/run_measured.sh --autoscale): AUTOSCALE=1
# makes deploy_nim_gke.sh create gpupool with 0 nodes and GKE cluster
# autoscaler enabled, instead of a fixed 1-node pool. MAX_GPU_NODES caps the
# autoscaler (and is the node count run_measured.sh --two-nodes scales to;
# that flag requires MAX_GPU_NODES>=2). Default AUTOSCALE=0 keeps
# deploy_nim_gke.sh byte-for-byte unchanged in effect. Unmeasured path.
export AUTOSCALE="${AUTOSCALE:-0}"
export MAX_GPU_NODES="${MAX_GPU_NODES:-1}"

export NIM_CHART_URL="https://helm.ngc.nvidia.com/nim/charts/nim-llm-${NIM_CHART_VERSION}.tgz"

# NGC credential helpers. The key never appears in a command line (ps) or a file:
# curl reads it from a config on stdin; kubectl reads it through process substitution.
ngc_curl() {
  printf 'user = "$oauthtoken:%s"\n' "${NGC_API_KEY}" | curl -K - "$@"
}
ngc_fetch_chart() {  # $1 = destination directory
  ngc_curl -fsSL -o "$1/nim-llm-${NIM_CHART_VERSION}.tgz" "${NIM_CHART_URL}"
}
ngc_apply_secrets() {  # $1 = namespace; creates registry-secret and ngc-api
  local auth
  auth="$(printf '%s:%s' '$oauthtoken' "${NGC_API_KEY}" | base64 | tr -d '\n')"
  kubectl create secret generic registry-secret \
    --type=kubernetes.io/dockerconfigjson \
    --from-file=.dockerconfigjson=<(printf '{"auths":{"nvcr.io":{"username":"$oauthtoken","password":"%s","auth":"%s"}}}' "${NGC_API_KEY}" "${auth}") \
    -n "$1" --dry-run=client -o yaml | kubectl apply -f -
  kubectl create secret generic ngc-api \
    --from-file=NGC_API_KEY=<(printf '%s' "${NGC_API_KEY}") \
    -n "$1" --dry-run=client -o yaml | kubectl apply -f -
}

# Call after sourcing, in any script that talks to GCP.
require_project_id() {
  if [[ -z "${PROJECT_ID}" || "${PROJECT_ID}" == "your-gcp-project" ]]; then
    echo "ERROR: set PROJECT_ID to your GCP project (export PROJECT_ID=...)" >&2
    exit 1
  fi
}
