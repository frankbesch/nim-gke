#!/bin/bash
# Stub gcloud for cleanup_test.sh. Never touches the network.
set -euo pipefail

echo "gcloud $*" >> "${STUB_LOG}"

case "$1 $2" in
  "projects describe")
    exit 0
    ;;
esac

case "$1 $2 $3" in
  "container clusters describe")
    if [[ "${STUB_CLUSTER:-}" == "absent" ]]; then
      echo "ERROR: (gcloud.container.clusters.describe) ResponseError: code=404, message=Not found: NOT_FOUND" >&2
      exit 1
    fi
    exit 0
    ;;
  "container clusters list")
    # STUB_CLUSTERS_LIST_EXIT (default 0): non-zero simulates the list call
    # itself failing (E6: final check cannot verify teardown).
    # STUB_CLUSTERS_LIST_OUTPUT: printed as output when set, e.g. to
    # simulate the cluster still being listed after a failed cleanup (E5).
    # Default: prints nothing, i.e. no cluster with that name anywhere.
    if [[ "${STUB_CLUSTERS_LIST_EXIT:-0}" != "0" ]]; then
      echo "ERROR: (gcloud.container.clusters.list) stub simulated failure" >&2
      exit "${STUB_CLUSTERS_LIST_EXIT}"
    fi
    if [[ -n "${STUB_CLUSTERS_LIST_OUTPUT:-}" ]]; then
      echo "${STUB_CLUSTERS_LIST_OUTPUT}"
    fi
    exit 0
    ;;
  "container clusters delete")
    exit 0
    ;;
  "container node-pools describe")
    # tests/deploy_autoscale_test.sh: STUB_NODEPOOL absent (default) forces
    # the create branch in deploy_nim_gke.sh so the create call is logged.
    if [[ "${STUB_NODEPOOL:-absent}" == "absent" ]]; then
      echo "ERROR: (gcloud.container.node-pools.describe) ResponseError: code=404, message=Not found: NOT_FOUND" >&2
      exit 1
    fi
    exit 0
    ;;
  "container node-pools create")
    exit 0
    ;;
esac

case "$1 $2" in
  "compute disks")
    # `gcloud compute disks list ...`: STUB_DISKS_LIST_EXIT (default 0)
    # non-zero simulates the list call itself failing. Otherwise prints
    # STUB_DISKS_OUTPUT if set (run_measured_test.sh uses this to simulate
    # a leftover disk); no output by default, i.e. no leftover disks.
    if [[ "${STUB_DISKS_LIST_EXIT:-0}" != "0" ]]; then
      echo "ERROR: (gcloud.compute.disks.list) stub simulated failure" >&2
      exit "${STUB_DISKS_LIST_EXIT}"
    fi
    if [[ -n "${STUB_DISKS_OUTPUT:-}" ]]; then
      echo "${STUB_DISKS_OUTPUT}"
    fi
    exit 0
    ;;
esac

# `gcloud container operations list ...` (run_measured.sh): no output needed.
exit 0
